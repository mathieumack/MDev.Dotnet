<Project>
  <ItemGroup>
    <_MDevAgentSkillPackage Include="$(MSBuildThisFileName)">
      <SourceDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..', 'skills', 'mdev-dotnet'))</SourceDirectory>
    </_MDevAgentSkillPackage>
  </ItemGroup>

  <UsingTask TaskName="MDevFindAgentSkillRoot"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <StartDirectory ParameterType="System.String" Required="true" />
      <RepositoryRoot ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var directory = new System.IO.DirectoryInfo(StartDirectory);
        System.IO.DirectoryInfo solutionRoot = null;

        while (directory != null)
        {
            var gitPath = System.IO.Path.Combine(directory.FullName, ".git");
            if (System.IO.Directory.Exists(gitPath) || System.IO.File.Exists(gitPath))
            {
                RepositoryRoot = directory.FullName;
                break;
            }

            if (solutionRoot == null &&
                directory.GetFiles("*.sln", System.IO.SearchOption.TopDirectoryOnly).Length > 0)
            {
                solutionRoot = directory;
            }

            directory = directory.Parent;
        }

        RepositoryRoot = RepositoryRoot ?? solutionRoot?.FullName ?? StartDirectory;
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="MDevInstallLatestAgentSkill"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourceDirectory ParameterType="System.String" Required="true" />
      <TargetDirectory ParameterType="System.String" Required="true" />
      <InstalledVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sourceSkill = System.IO.Path.Combine(SourceDirectory, "SKILL.md");
        var targetSkill = System.IO.Path.Combine(TargetDirectory, "SKILL.md");
        var versionPattern = new System.Text.RegularExpressions.Regex(
            @"(?m)^- Source version: (?<version>[^\r\n]+)$");

        System.Func<string, string, int> compareVersions = (left, right) =>
        {
            var leftParts = left.Split(new[] { '+' }, 2)[0].Split(new[] { '-' }, 2);
            var rightParts = right.Split(new[] { '+' }, 2)[0].Split(new[] { '-' }, 2);
            var leftCore = leftParts[0].Split('.');
            var rightCore = rightParts[0].Split('.');

            for (var index = 0; index < System.Math.Max(leftCore.Length, rightCore.Length); index++)
            {
                int leftNumber;
                int rightNumber;
                if (index >= leftCore.Length ||
                    !int.TryParse(leftCore[index], out leftNumber))
                {
                    leftNumber = 0;
                }
                if (index >= rightCore.Length ||
                    !int.TryParse(rightCore[index], out rightNumber))
                {
                    rightNumber = 0;
                }
                if (leftNumber != rightNumber)
                {
                    return leftNumber.CompareTo(rightNumber);
                }
            }

            var leftPrerelease = leftParts.Length == 2 ? leftParts[1] : null;
            var rightPrerelease = rightParts.Length == 2 ? rightParts[1] : null;
            if (leftPrerelease == null || rightPrerelease == null)
            {
                return leftPrerelease == rightPrerelease
                    ? 0
                    : leftPrerelease == null ? 1 : -1;
            }

            var leftIdentifiers = leftPrerelease.Split('.');
            var rightIdentifiers = rightPrerelease.Split('.');
            for (var index = 0;
                 index < System.Math.Max(leftIdentifiers.Length, rightIdentifiers.Length);
                 index++)
            {
                if (index >= leftIdentifiers.Length)
                {
                    return -1;
                }
                if (index >= rightIdentifiers.Length)
                {
                    return 1;
                }

                int leftNumber;
                int rightNumber;
                var leftIsNumber = int.TryParse(leftIdentifiers[index], out leftNumber);
                var rightIsNumber = int.TryParse(rightIdentifiers[index], out rightNumber);
                if (leftIsNumber && rightIsNumber && leftNumber != rightNumber)
                {
                    return leftNumber.CompareTo(rightNumber);
                }
                if (leftIsNumber != rightIsNumber)
                {
                    return leftIsNumber ? -1 : 1;
                }

                var comparison = string.Compare(
                    leftIdentifiers[index],
                    rightIdentifiers[index],
                    System.StringComparison.Ordinal);
                if (comparison != 0)
                {
                    return comparison;
                }
            }
            return 0;
        };

        System.Func<string, string> readVersion = skillPath =>
        {
            var match = versionPattern.Match(System.IO.File.ReadAllText(skillPath));
            if (!match.Success)
            {
                throw new System.InvalidOperationException(
                    "MDev.Dotnet agent skill has no source version: " + skillPath);
            }
            return match.Groups["version"].Value;
        };

        var sourceVersion = readVersion(sourceSkill);
        var lockPath = TargetDirectory.TrimEnd(
            System.IO.Path.DirectorySeparatorChar,
            System.IO.Path.AltDirectorySeparatorChar) + ".lock";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(TargetDirectory));

        System.IO.FileStream installLock = null;
        for (var attempt = 0; attempt < 200 && installLock == null; attempt++)
        {
            try
            {
                installLock = new System.IO.FileStream(
                    lockPath,
                    System.IO.FileMode.OpenOrCreate,
                    System.IO.FileAccess.ReadWrite,
                    System.IO.FileShare.None);
            }
            catch (System.IO.IOException)
            {
                System.Threading.Thread.Sleep(25);
            }
        }
        if (installLock == null)
        {
            throw new System.TimeoutException(
                "Timed out waiting to install the MDev.Dotnet agent skill.");
        }

        using (installLock)
        {
            var shouldInstall = true;
            if (System.IO.File.Exists(targetSkill))
            {
                InstalledVersion = readVersion(targetSkill);
                shouldInstall = compareVersions(sourceVersion, InstalledVersion) > 0;
            }

            if (shouldInstall)
            {
                if (System.IO.Directory.Exists(TargetDirectory))
                {
                    System.IO.Directory.Delete(TargetDirectory, true);
                }

                foreach (var sourceFile in System.IO.Directory.GetFiles(
                    SourceDirectory,
                    "*",
                    System.IO.SearchOption.AllDirectories))
                {
                    var relativePath = sourceFile.Substring(SourceDirectory.Length);
                    var targetFile = System.IO.Path.Combine(TargetDirectory, relativePath);
                    System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(targetFile));
                    System.IO.File.Copy(sourceFile, targetFile, true);
                }
                InstalledVersion = sourceVersion;
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="_InstallMDevAgentSkill"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(MDevInstallAgentSkill)' != 'false'">
    <MDevFindAgentSkillRoot StartDirectory="$(MSBuildProjectDirectory)">
      <Output TaskParameter="RepositoryRoot" PropertyName="_MDevAgentSkillRoot" />
    </MDevFindAgentSkillRoot>

    <PropertyGroup>
      <_MDevAgentSkillTargetDir>$([MSBuild]::NormalizeDirectory('$(_MDevAgentSkillRoot)', '.agents', 'skills', 'mdev-dotnet'))</_MDevAgentSkillTargetDir>
    </PropertyGroup>
    <MDevInstallLatestAgentSkill SourceDirectory="%(_MDevAgentSkillPackage.SourceDirectory)"
                                TargetDirectory="$(_MDevAgentSkillTargetDir)">
      <Output TaskParameter="InstalledVersion"
              PropertyName="_MDevAgentSkillInstalledVersion" />
    </MDevInstallLatestAgentSkill>
    <Message Importance="high"
             Text="MDev.Dotnet agent skill $(_MDevAgentSkillInstalledVersion) is installed in $(_MDevAgentSkillTargetDir)" />
  </Target>
</Project>
